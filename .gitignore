/data/**
!/data/.gitkeep

# Model weights and checkpoints
/models/**
!/models/.gitkeep
*.pt
*.pth
*.ckpt
*.onnx

# Generated reports and figures
/reports/**
!/reports/.gitkeep

# Notebook checkpoints
.ipynb_checkpoints/

# Generated Python and application logs
*.log

# Editor and operating system files
.vscode/
.idea/
.DS_Store
