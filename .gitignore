# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local environment configuration
.venv*/
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
.kaggle/
